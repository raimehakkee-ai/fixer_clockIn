{
  "name": "clockin-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-auth.mjs && node scripts/smoke-admin.mjs && node scripts/smoke-attendance.mjs && node scripts/smoke-leave.mjs && node scripts/smoke-reports.mjs",
    "smoke:security": "node scripts/smoke-security.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "staging:bootstrap": "tsx scripts/bootstrap-staging.ts",
    "admin:create": "tsx scripts/create-admin.mjs",
    "attendance:finalize": "tsx scripts/finalize-attendance.ts",
    "db:studio": "prisma studio",
    "db:local": "prisma dev --detach"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.16.0",
    "tsx": "^4.20.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
