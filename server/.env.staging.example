NODE_ENV=production
PORT=4100
DATABASE_URL="postgresql://clockin_staging:CHANGE_ME@127.0.0.1:5432/clockin_staging"
JWT_ACCESS_SECRET="GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=https://staging-clockin.example.com,https://staging-clockin-admin.example.com
STORAGE_DRIVER=local
UPLOAD_DIR=/opt/clockin-staging/server/uploads
MAX_UPLOAD_MB=5
ACCURACY_LIMIT_M=100
CLOCK_OUT_GRACE_MINUTES=240
# Staging/UAT web boleh; produksi harus false.
ALLOW_WEB_ATTENDANCE=true
LOGIN_IP_LIMIT_MAX=120
REFRESH_LIMIT_MAX=300
TRUST_PROXY=1
# S3 (opsional)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
