NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clockin"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:8081,http://localhost:8082,http://localhost:5173
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ACCURACY_LIMIT_M=100
# Grace period Clock-Out setelah jam selesai shift (menit).
CLOCK_OUT_GRACE_MINUTES=240
# Batas login per IP dan refresh per IP (15 menit). Dinaikkan agar
# pergantian shift dari jaringan kantor dengan satu NAT tidak saling blokir.
LOGIN_IP_LIMIT_MAX=120
REFRESH_LIMIT_MAX=300
# Jumlah hop reverse proxy yang dipercaya untuk X-Forwarded-For.
# false = langsung (tanpa proxy), 1 = satu Nginx di depan API.
TRUST_PROXY=1
# Hanya dipakai bila STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
